{
  "manifest_version": 3,
  "name": "Obelista Ingest",
  "version": "0.1.4",
  "description": "Передаёт user_token и состояние Ads Manager в obelista-preview",
  "permissions": ["cookies", "storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://graph.facebook.com/*",
    "https://obelista-preview-chi.vercel.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://adsmanager.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Obelista Ingest"
  },
  "options_page": "options.html"
}
